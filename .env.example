# ── Session tokens ───────────────────────────────────────────────────────────
# Signs the short-TTL session JWTs issued by POST /api/skin/session.
# In production this MUST be the Supabase JWT secret, so the same token also
# passes RLS for direct client reads (the policies read the session_id claim).
SESSION_JWT_SECRET=

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated allowlist of storefront origins permitted to call the API.
# The browser blocks every other origin (spec §10).
SHOPIFY_STOREFRONT_ORIGIN=https://your-store.myshopify.com

# ── Supabase (server-only; never expose to the client) ──────────────────────
# Required. The API refuses to serve without a database — no silent fallback.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Vision ───────────────────────────────────────────────────────────────────
# 'mock' (default) until a real adapter (hautai / perfectCorp) is implemented.
VISION_PROVIDER=mock

# ── Retention purge ──────────────────────────────────────────────────────────
# Bearer token for GET /api/skin/purge. Vercel Cron sends it automatically once
# this is set as a project env var. Unset = the endpoint 401s everyone.
CRON_SECRET=
